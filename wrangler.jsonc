{
	"name": "site",
	"compatibility_date": "2026-01-15",
	"compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public",
        // "no_handle_cross_request_promise_resolution"
    ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}
